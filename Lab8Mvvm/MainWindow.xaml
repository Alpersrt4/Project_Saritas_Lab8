<Window x:Class="Lab8Mvvm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Lab8Mvvm.ViewModels"
        Title="Laboratory Work 8 - MVVM"
        Height="520"
        Width="850"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Laboratory Work 8 - MVVM and Unit Testing"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Owner:" Width="60" VerticalAlignment="Center"/>
                <TextBox Width="250"
                         Margin="0,0,10,0"
                         Text="{Binding NewOwner, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Content="Add" Width="85" Margin="0,0,8,0" Command="{Binding AddCommand}"/>
                <Button Content="Delete" Width="85" Margin="0,0,8,0" Command="{Binding DeleteCommand}"/>
                <Button Content="Save" Width="85" Command="{Binding SaveCommand}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Filter:" Width="60" VerticalAlignment="Center"/>
                <TextBox Width="250"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding FilteredItems}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Owner" Width="*" Binding="{Binding Owner}"/>
                <DataGridTextColumn Header="Password" Width="220" Binding="{Binding Password}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="8" BorderThickness="1" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
